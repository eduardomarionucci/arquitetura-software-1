meta {
  name: Listar clientes
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/clientes
  body: none
  auth: none
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Validar resposta", function () {
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().some(c => c.id === Number(bru.getVar("cliente_id")))).to.equal(true);
  });
}
