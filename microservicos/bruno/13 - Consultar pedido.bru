meta {
  name: Consultar pedido
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/pedidos/{{pedido_id}}
  body: none
  auth: none
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Validar resposta", function () {
    expect(res.getBody().id).to.equal(Number(bru.getVar("pedido_id")));
  });
}
